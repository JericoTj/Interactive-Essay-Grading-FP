generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  essays    Essay[]
  rubrics   Rubric[]
  createdAt DateTime @default(now())
}

model Essay {
  id            Int            @id @default(autoincrement())
  title         String
  content       String         @default("")
  fileUrl       String?
  fileKey       String?
  fileName      String?
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  gradingResult GradingResult?
  createdAt     DateTime       @default(now())
}

model Rubric {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  fileUrl     String?
  fileKey     String?
  fileName    String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model GradingResult {
  id                Int      @id @default(autoincrement())
  essayId           Int      @unique
  essay             Essay    @relation(fields: [essayId], references: [id])
  overallScore      Float
  overallFeedback   String
  grammarScore      Float
  grammarFeedback   String
  structureScore    Float
  structureFeedback String
  clarityScore      Float
  clarityFeedback   String
  annotations       String
  gradedAt          DateTime @default(now())
}

